# skills: Venom Claw (poison, always lands). The poison then takes HP on the enemy's own turns (watch hp9). Gabryel alone at level 39 (level index 38 pinned, battle MP pinned to 50), first temple battle.
# On the Special list Down reaches the skill (shot vc_list), A opens the enemy grid,
# Down moves to the first front-row enemy (battler 9, which stays in its slot; vc_grid), A casts:
# after the enemies' turns she runs in, strikes without damage, and the green ring shows on it (shots
# vc_a to vc_i), the MP is taken, and its status goes 0 -> 6. By the next round a back-row
# enemy has dropped into front slot 8, so Down, Right reaches battler 9: the name bar reads its name
# and "Psn" (vc_tag) and A is refused with "No effect!" (vc_refused), no MP taken.
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18). Run with --save.
include party_gabryel
pin u32 0x020B471C 38
pinptr u32 0x020B8620 0x18 50
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
watch u32 0x0228ec40 hp9
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 50
shot vc_list
press A 8
wait 80
press Down 8
wait 30
shot vc_grid
press A 8
wait 30
wait 210
wait 30
shot vc_a
wait 30
shot vc_b
wait 30
shot vc_c
wait 30
shot vc_d
wait 30
shot vc_e
wait 30
shot vc_f
wait 30
shot vc_g
wait 30
shot vc_h
wait 30
shot vc_i
waituntil u32 0x020B0010 7 3000
wait 110
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 50
press A 8
wait 80
press Down 8
wait 30
press Right 8
wait 30
shot vc_tag
press A 8
wait 30
shot vc_refused
wait 100
shot vc_after
# Then B, Fight on the enemy in front slot 8 (Left, A, A), and a round passes: battler 9 loses 5 percent
# of its max HP on its own turn (97 -> 93; shot vc_poison).
press B 8
wait 60
press Left 8
wait 50
press A 8
wait 50
press A 8
wait 30
wait 240
waituntil u32 0x020B0010 7 3000
shot vc_poison
