wait 3
shot ss_open_12
wait 3
shot ss_open_13
wait 3
shot ss_open_14
wait 3
shot ss_open_15
wait 3
shot ss_open_16
wait 3
shot ss_open_17
wait 3
shot ss_open_18
wait 3
shot ss_open_19
wait 3
shot ss_open_20
wait 3
shot ss_open_21
wait 3
shot ss_open_22
wait 3
shot ss_open_23
wait 3
shot ss_open_24
wait 30
shot ss_save
press B 3
wait 40
shot ss_system
press A 3
wait 40
