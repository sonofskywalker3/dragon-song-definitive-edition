# Select shortcuts (feat_field_menu.py), frame by frame: Select in the field -> save screen behind a black
# screen; B -> System list; Select -> field; X, A (Status), Select -> field; X, B as before.
include boot_from_save
wait 250
watch u32 0x020B000C mode
watch u32 0x020B0010 state
press Select 2
wait 3
shot ss_open_1
wait 3
shot ss_open_2
wait 3
shot ss_open_3
wait 3
shot ss_open_4
wait 3
shot ss_open_5
wait 3
