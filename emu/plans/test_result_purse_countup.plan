# Silver line on the EXP page shows the purse counting up (result-screens): the purse is set to 1240 before
# the first Delrich Temple battle (101 silver); with no A during the pour the line counts 1240 -> 1341. Run with --save.
watch u16 0x020B85C8 result_sub
watch u32 0x020B4824 silver
watch u32 0x020B4694 jian_exp32
watch u32 0x01FF8344 silver_gained
include boot_from_save
include cheats_strong
include warp6
poke u32 0x020B4824 1240
dump 0x0213B930 0x200 inv_before
wait 300
press A 3
