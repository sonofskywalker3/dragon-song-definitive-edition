# Silver count-up on the EXP page (result-screens): screenshots every 40 frames while the EXP pours;
# the Silver line must count up from 0 to 101 with the pour. Jian alone, first temple battle. Run with --save. 52 A presses win the first Delrich Temple battle (victory near frame 4260).
watch u16 0x020B85C8 result_sub
watch u32 0x020B4824 silver
watch u32 0x020B4694 jian_exp32
watch u32 0x01FF8344 silver_gained
include boot_from_save
include cheats_strong
include warp6
dump 0x0213B930 0x200 inv_before
