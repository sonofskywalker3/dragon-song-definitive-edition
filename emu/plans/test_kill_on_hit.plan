# kill-on-hit: Jian's 3-hit combo against the two front enemies (battlers 9 and 10) at 1 HP each. Each should
# die right after the hit that kills it (HP drops at the hit) while Jian carries on, not both after the combo.
# HP of battle stat record r: 0x0228E860 + r * 0x6C + 0x14.
include boot_from_save
include cheats_strong
include warp6
wait 270
peek u32 0x020B8620 stats_ptr
poke u16 0x0228EC40 1
poke u16 0x0228ECAC 1
watch u16 0x0228EC40 hp9
watch u16 0x0228ECAC hp10
exec 0x02030BC8 hit
press A 3
wait 60
press A 3
wait 60
press A 3
wait 60
press A 3
wait 8
shot kh_01
wait 8
shot kh_02
wait 8
shot kh_03
wait 8
shot kh_04
wait 8
shot kh_05
wait 8
shot kh_06
wait 8
shot kh_07
wait 8
shot kh_08
wait 8
shot kh_09
wait 8
shot kh_10
wait 8
shot kh_11
wait 8
shot kh_12
wait 8
shot kh_13
wait 8
