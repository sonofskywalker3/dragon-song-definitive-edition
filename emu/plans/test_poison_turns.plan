# status rules: poison wears off after 2 to 4 of the poisoned battler's turns (docs/plan-cards.md 8, point 3).
# Gabryel (level 30) casts Venom Claw on battler 9 as test_skill_venom_claw, then Fights each round (Right on
# the grid, away from battler 9; the other enemies' HP pinned). Expect status9 0 -> 6 with turns9 3 to 5, hp9
# dropping by 4 on each of its turns while turns9 counts down, then status9 back to 0. Run with --save.
include party_gabryel
pin u32 0x020B471C 29
pinptr u32 0x020B8620 0x18 50
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
watch u32 0x0228ec40 hp9
watch u16 0x0228ec78 turns9
pin u32 0x0228ea24 500
pin u32 0x0228ea90 500
pin u32 0x0228eafc 500
pin u32 0x0228ebd4 500
pin u32 0x0228ecac 500
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
shot vc_list
press A 8
wait 80
press Down 8
wait 30
shot vc_grid
press A 8
wait 30
wait 210
wait 30
shot vc_a
wait 30
shot vc_b
wait 30
shot vc_c
wait 30
shot vc_d
wait 30
shot vc_e
wait 30
shot vc_f
wait 30
shot vc_g
wait 30
shot vc_h
wait 30
shot vc_i
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
waituntil u32 0x020B0010 7 3000
wait 110
press A 8
wait 50
press Right 8
wait 30
press A 8
wait 40
shot pt_end
