# skills: Howl's success roll at 69. As test_skill_howl, with the random state set to 16
# (roll 69): the MP is taken (50 -> 41) and the status goes 0 -> 4 (69 is under the 70 percent chance) (shots h69_a to
# h69_i). Rolls 69 and 70 sit on either side of the cutoff, so a wrong comparison shows.
# Run with --save.
# Gabryel at level 30 (level index 29): from 39 Dread Roar takes Howl's place in the list.
include party_gabryel
pin u32 0x020B471C 29
pinptr u32 0x020B8620 0x18 50
execpoke 0x020503A0 u32 0x020A0238 16
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Right 8
wait 50
press A 8
wait 80
press Down 8
wait 30
press A 8
wait 30
wait 210
wait 30
shot h69_a
wait 30
shot h69_b
wait 30
shot h69_c
wait 30
shot h69_d
wait 30
shot h69_e
wait 30
shot h69_f
wait 30
shot h69_g
wait 30
shot h69_h
wait 30
shot h69_i
