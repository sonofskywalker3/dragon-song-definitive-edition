# spell-levels: Flora learns Miracle Tears at level 32 and it revives. Jian (slot 0, his field HP held at
# 0 so he starts the battle knocked out) and Flora (slot 1, level 32: level index 31 pinned, MP 60 through
# the field record), first temple battle. Flora's Special list (mt_list on Miracle Tears, the fifth
# entry), the game's ally picker (mt_picker) with Jian picked, and the cast: MP 60 -> 40 and Jian's
# battle HP 0 -> a tenth of his max (mt_a to mt_t).
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18). Run with --save.
include boot_from_save
pin u16 0x020B4780 999
pin u16 0x020B477C 999
pin u16 0x020B464C 0
pin u16 0x020B4650 3
pin u16 0x020B4654 65535
pin u32 0x020B4668 0
pin u32 0x020b4784 60
pin u32 0x020b4788 60
pin u32 0x020b4778 31
include warp6
pin u16 0x020B4780 999
pin u16 0x020B477C 999
pin u16 0x020B464C 0
pin u16 0x020B4650 3
pin u16 0x020B4654 65535
pin u32 0x020B4668 0
pin u32 0x020b4784 60
pin u32 0x020b4788 60
pin u32 0x020b4778 31
wait 270
peek u32 0x020B8620 records
battlers
watch u32 0x0228e8e4 flora_mp
watch u32 0x0228e874 jian_hp
shot mt_start
press A 8
wait 50
shot mt_cmd
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Right 8
wait 50
shot mt_list
press A 8
wait 60
shot mt_picker
press A 8
wait 30
waituntil u32 0x0228e8e4 40 3000
wait 8
shot mt_a
wait 8
shot mt_b
wait 8
shot mt_c
wait 8
shot mt_d
wait 8
shot mt_e
wait 8
shot mt_f
wait 8
shot mt_g
wait 8
shot mt_h
wait 8
shot mt_i
wait 8
shot mt_j
wait 8
shot mt_k
wait 8
shot mt_l
wait 8
shot mt_m
wait 8
shot mt_n
wait 8
shot mt_o
wait 8
shot mt_p
wait 8
shot mt_q
wait 8
shot mt_r
wait 8
shot mt_s
wait 8
shot mt_t
