# skills: Gabryel's Special list by level, and Gale Cut unchanged. Gabryel alone (party_gabryel), first
# temple battle; her level index (0x020B471C) is poked before each look at the list. Level 12: only Gale
# Cut (shot gl_1). Level 13: Venom Claw too (gl_2). Level 31: six entries, one page (gl_6). Level 35:
# seven, with the PAGE tab (gl_7, and gl_7_page2 after Right from the last column). Level 39: eight
# (gl_8, gl_8_page2). Then Gale Cut is cast from the list: every enemy takes damage and 10 MP goes
# (50 -> 40), as before the skills (shots gl_a to gl_i). Run with --save.
include party_gabryel
pinptr u32 0x020B8620 0x18 50
poke u32 0x020B471C 11
wait 270
watch u32 0x0228e878 gabryel_mp
watch u32 0x0228ea24 hp4
watch u32 0x0228ea90 hp5
watch u32 0x0228eafc hp6
watch u32 0x0228ebd4 hp8
watch u32 0x0228ec40 hp9
watch u32 0x0228ecac hp10
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
shot gl_1
dump 0x020B8844 20 list_gl_1
press Down 8
wait 50
press Right 8
wait 50
shot gl_1_moved
press B 8
wait 60
poke u32 0x020B471C 12
press Right 8
wait 50
press A 8
wait 60
shot gl_2
dump 0x020B8844 20 list_gl_2
press B 8
wait 60
poke u32 0x020B471C 30
press Right 8
wait 50
press A 8
wait 60
shot gl_6
dump 0x020B8844 20 list_gl_6
press B 8
wait 60
poke u32 0x020B471C 34
press Right 8
wait 50
press A 8
wait 60
shot gl_7
dump 0x020B8844 20 list_gl_7
press Right 8
wait 50
press Right 8
wait 50
press Right 8
wait 50
shot gl_7_page2
press B 8
wait 60
poke u32 0x020B471C 38
press Right 8
wait 50
press A 8
wait 60
shot gl_8
dump 0x020B8844 20 list_gl_8
press Right 8
wait 50
press Right 8
wait 50
press Right 8
wait 50
shot gl_8_page2
press Left 8
wait 50
press Left 8
wait 50
press Left 8
wait 50
shot gl_8_back
press A 8
wait 30
wait 210
wait 30
shot gl_a
wait 30
shot gl_b
wait 30
shot gl_c
wait 30
shot gl_d
wait 30
shot gl_e
wait 30
shot gl_f
wait 30
shot gl_g
wait 30
shot gl_h
wait 30
shot gl_i
waituntil u32 0x020B0010 7 3000
shot gl_after
