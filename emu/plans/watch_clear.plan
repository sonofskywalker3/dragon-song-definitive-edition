shot k02_after_clear
save k_cleared
# the drop chest lands on Jian (the symbol was pulled onto him): move him 48 px up, off it
poke u32 0x020B6CB8 0x438000
wait 5
include watch_shuttle
shot k03_closed_after_shuttle
