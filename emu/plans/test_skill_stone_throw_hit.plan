# skills: Stone Throw that hits: as test_skill_stone_throw, with the battle's sure-hit flag (Focus, bit 4 of the
# battle work's first word) set, so the stone cannot miss. Seen: 148 over the second flyer and it falls
# (build/stone_hit/stone_throw.gif).
# Battle records at 0x0228E860 (0x6C each: HP +0x14, MP +0x18). Run with --save.
include boot_from_save
include cheats_strong
include warp6
include cheats_strong
pin u32 0x020B4664 3
pinptr u32 0x020B8620 0x18 50
pinptr u32 0x020B8550 0x0 4
wait 270
peek u32 0x020B8620 records
peek u32 0x020B8640 battlers_base
watch u32 0x0228E878 jian_mp
watch u32 0x0228EAB0 hp5
press A 8
wait 50
