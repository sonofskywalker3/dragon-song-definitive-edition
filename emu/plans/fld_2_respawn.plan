# Field test (generated by a script, emu/gen_fld_plans.py; run with emu/run_fld.sh, see docs/test-report-field.md). Delrich Temple map 6.
# Part 2: second battle, stay on the map, menu, locked blue chest, leave and come back. Saves fld_back.
load fld_k1
include fld_cheats
# park the enemy symbols on a far spawn point (0x138,0x220) so none wanders into Jian
pin u32 0x020b7058 0x138000
pin u32 0x020b705c 0x220000
pin u32 0x020b7098 0x138000
pin u32 0x020b709c 0x220000
pin u32 0x020b70d8 0x138000
pin u32 0x020b70dc 0x220000
pin u32 0x020b7118 0x138000
pin u32 0x020b711c 0x220000
pin u32 0x020b7158 0x138000
pin u32 0x020b715c 0x220000
pin u32 0x020b7198 0x138000
pin u32 0x020b719c 0x220000
pin u32 0x020b71d8 0x138000
pin u32 0x020b71dc 0x220000
pin u32 0x020b7218 0x138000
pin u32 0x020b721c 0x220000
exec 0x0201D92C load_map
exec 0x0201E0EC entry_init
watch u8 0x020B4912 kills6
watch u8 0x020B4913 total6
watch u16 0x020B490E clock6
watch u16 0x020B6BE4 map
watch u32 0x020B0010 fstate
watch u8 0x020B7848 clear_flag
watch u16 0x020B4668 jian_hp
watch u16 0x020B4670 jian_mp
watch u16 0x020B7034 bluechest_opened
unpin
include fld_cheats
# low HP and MP so a +30% area-clear refill would show
poke u16 0x020B4668 20
poke u16 0x020B4670 1
poke u32 0x020B6CB4 0x208000
poke u32 0x020B6CB8 0xd4000
# pull the enemy symbols onto Jian for 10 frames: contact starts a battle; win it with A
pin u32 0x020b7058 0x208000
pin u32 0x020b705c 0xd4000
pin u32 0x020b7098 0x208000
pin u32 0x020b709c 0xd4000
pin u32 0x020b70d8 0x208000
pin u32 0x020b70dc 0xd4000
pin u32 0x020b7118 0x208000
pin u32 0x020b711c 0xd4000
pin u32 0x020b7158 0x208000
pin u32 0x020b715c 0xd4000
pin u32 0x020b7198 0x208000
pin u32 0x020b719c 0xd4000
pin u32 0x020b71d8 0x208000
pin u32 0x020b71dc 0xd4000
pin u32 0x020b7218 0x208000
pin u32 0x020b721c 0xd4000
wait 10
unpin
