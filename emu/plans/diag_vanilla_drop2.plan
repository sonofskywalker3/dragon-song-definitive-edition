# Vanilla reference: round state, refill mask and slots 4 / 8 through two rounds of the first temple battle.
include boot_from_save
include warp6
wait 270
watch u16 0x0228296E round_state
watch u16 0x02282A12 refill_mask
watch u32 0x0228F700 flags8
watch u32 0x0228F270 flags4
press A 3
