# Manual targeting with a real multi-hit attack: Flora's bow. Run with --save.
# Flora (character id 3) rolls her Attack hit count as rand % byte[0x0213B919] + 1 (func_020514ec,
# 0x02051BE4). That byte is rebuilt from the actor's gear at every action (func_0206ab6c, so pinning it
# does nothing): weapon effect 0x2B gives 2, 0x2C gives 3. Composite Bow (item 39, effect 0x2C) goes in
# her weapon slot (character struct +0x40), so her attacks hit 1 to 3 times.
# Flora alone (party slot 0 = 3, slot 1 empty) in the temple battle: back row Ticks in battlers 4, 5, 6;
# front row 9 (left) and 10 (right). She picks the bottom-left cell (battler 9), whose HP is set to 1 so
# her first hit kills it; her other hits must land on the next living enemy instead.
# HP of battle stat record r: 0x0228E860 + r * 0x6C + 0x14; damage waits in +0x60 until the action ends.
include boot_from_save
poke u16 0x020B464C 3
poke u16 0x020B4650 65535
poke u16 0x020B4780 999
poke u16 0x020B477C 999
poke u16 0x020B47AC 39
# DEX and AGI 255 so her arrows land and she acts first (test only)
poke u8 0x020B47A0 255
poke u8 0x020B4798 255
include warp6
wait 270
peek u32 0x020B8620 stats_ptr
battlers
poke u16 0x0228EA24 300
poke u16 0x0228EA90 300
poke u16 0x0228EAFC 300
poke u16 0x0228EC40 1
poke u16 0x0228ECAC 999
watch u16 0x0228EA24 hp4
watch u16 0x0228EA90 hp5
watch u16 0x0228EAFC hp6
watch u16 0x0228EC40 hp9
watch u16 0x0228ECAC hp10
watch u32 0x0228EC8C pending9
watch u32 0x0228ECF8 pending10
exec 0x02051BFC hit_roll
exec 0x02051C48 pick_target
exec 0x02030BC8 hit_alive
shot mhf0
press A 3
wait 60
press A 3
wait 60
press A 3
wait 60
shot mhf1_picker
press Down 3
wait 20
shot mhf2_picked
press A 3
wait 15
