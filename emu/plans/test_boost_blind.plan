# cards: Gabryel at level 30 (Blinding Swipe known) wears Asmodee (card 247) with 1200 points (0x020B48C2).
# Blinding Swipe on battler 9: status 0 -> 2, points 1200 -> 1100, and its turns counter (+0x4C) set to 4 to 6
# instead of 2 to 4. Run with --save.
include party_gabryel
pin u32 0x020B471C 29
pinptr u32 0x020B8620 0x18 50
poke u8 0x0213BA26 1
poke u16 0x020B48C2 1200
poke u16 0x020B475A 247
wait 270
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ec34 status9
watch u32 0x0228ec40 hp9
watch u32 0x0228ec48 maxhp9
watch u16 0x0228ec78 turns9
watch u16 0x020B48C2 points
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 50
press Right 8
wait 50
shot bv_name
press A 8
wait 80
press Down 8
wait 30
shot grid
press A 8
wait 30
shot picked
wait 210
waituntil u32 0x020B0010 7 3000
wait 110
shot bv_round2
