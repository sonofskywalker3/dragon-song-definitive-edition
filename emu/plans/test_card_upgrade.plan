# cards: the upgraded version and the all-target refusal (docs/plan-cards.md 3). Jian wears Quetzalcoatl
# (his slot 5, 0x020B46A2 = 236) at 2000 points, his level index set to 8 (level 9, Weapon Break learned), so his
# use is on all enemies with no grid. Round 1: Jian's Special list (shots cg_list_*), the card entry: every
# enemy's ATK stage goes to -1 (watches stage_*), points 2000 -> 1900; Lucia Fights. Round 2: Jian's card again
# is refused at the list ("No effect!", shot cg_refused), points stay 1900.
include party2_strong
poke u8 0x0213BA1B 1
poke u16 0x020B48AC 2000
poke u16 0x020B46A2 236
poke u32 0x020B4664 8
pin u32 0x0228ea24 500
pin u32 0x0228ea90 500
pin u32 0x0228eafc 500
pin u32 0x0228ebd4 500
pin u32 0x0228ec40 500
pin u32 0x0228ecac 500
wait 270
watch u16 0x0228EA50 stage_0
watch u16 0x0228EABC stage_1
watch u16 0x0228EB28 stage_2
watch u16 0x0228EC00 stage_4
watch u16 0x0228EC6C stage_5
watch u16 0x0228ECD8 stage_6
watch u16 0x020B48AC points
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
shot cg_list_0
press Down 8
wait 30
press Right 8
wait 30
shot cg_list_card
press A 8
wait 40
shot cg_after_pick
press A 8
wait 50
press A 8
wait 60
shot cg_lucia_target
press A 8
wait 30
shot cg_use_00
wait 30
shot cg_use_01
wait 30
shot cg_use_02
wait 30
shot cg_use_03
wait 1400
shot cg_r2_start
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 30
press Right 8
wait 30
shot cg_r2_card
press A 8
wait 20
shot cg_refused
