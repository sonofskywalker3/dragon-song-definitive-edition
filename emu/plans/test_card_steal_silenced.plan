# cards: silence stops Steal (docs/plan-cards.md 5; docs/re-cards.md 3: a silenced member cannot use skills). As
# test_card_steal's first round, with Jian's battle status (stat record 0 + 8, 0x0228E868) set to 5, silence.
# Expect: Steal can be picked, but on his turn Jian attacks instead (shots ss_msg_*: 148 damage), no robbed bit,
# nothing stolen.
# Run with --save.
include party2_strong
poke u8 0x0213ba33 1
poke u16 0x020b46a2 260
pin u32 0x0228ea24 500
pin u32 0x0228ea90 500
pin u32 0x0228eafc 500
pin u32 0x0228ebd4 500
pin u32 0x0228ec40 500
pin u32 0x0228ecac 500
wait 270
poke u8 0x0228E868 5
watch u8 0x0228E868 jian_status
battlers
watch u32 0x02282940 flags
watch u16 0x01FFBB64 stolen
watch u32 0x0228e878 jian_mp
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
shot ss_list
press A 8
wait 60
shot ss_grid
press A 8
wait 60
press A 8
wait 60
press A 8
wait 60
waituntil u32 0x020B0010 8 3000
wait 20
shot ss_msg_0
wait 20
shot ss_msg_1
wait 20
shot ss_msg_2
wait 20
shot ss_msg_3
wait 20
shot ss_msg_4
wait 20
shot ss_msg_5
wait 20
shot ss_msg_6
wait 20
shot ss_msg_7
wait 20
shot ss_msg_8
wait 20
shot ss_msg_9
wait 20
shot ss_msg_10
wait 20
shot ss_msg_11
wait 20
shot ss_msg_12
wait 20
shot ss_msg_13
wait 20
shot ss_msg_14
wait 20
shot ss_msg_15
