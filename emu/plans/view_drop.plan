# Viewing: the tgt_no_leap setup (front row at 1 HP, flyers at 300) saved at the first command input, for
# watching the mid-combo drop at normal speed: EmuHawk --load-state=build/view/states/drop.State build/dsde.nds
include boot_from_save
include cheats_strong
include warp6
wait 270
poke u16 0x0228EA24 300
poke u16 0x0228EA90 300
poke u16 0x0228EAFC 300
poke u16 0x0228EC40 1
poke u16 0x0228ECAC 1
save drop
