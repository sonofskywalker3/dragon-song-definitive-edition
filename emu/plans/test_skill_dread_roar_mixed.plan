# skills: Dread Roar rolls for each enemy on its own. Gabryel alone at level 39 (level index 38 pinned,
# battle MP pinned to 50), first temple battle, with nothing forcing the random numbers during the cast
# (the state is set once, to 24, when the command is given, so the run is the same every time). Expect
# MP 50 -> 37 once and a mix: some statuses go 0 -> 4 and some stay 0, with MISS over those (shots
# dm_00 to dm_23). A cast that reused one roll for everyone would give all or none.
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18, ATK +0x24, ATK stage +0x40). Run with --save.
include party_gabryel
pin u32 0x020B471C 38
pinptr u32 0x020B8620 0x18 50
wait 270
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 50
press Right 8
wait 50
press Right 8
wait 50
shot dm_list
poke u32 0x020A0238 24
press A 8
wait 30
wait 120
wait 20
shot dm_00
wait 20
shot dm_01
wait 20
shot dm_02
wait 20
shot dm_03
wait 20
shot dm_04
wait 20
shot dm_05
wait 20
shot dm_06
wait 20
shot dm_07
wait 20
shot dm_08
wait 20
shot dm_09
wait 20
shot dm_10
wait 20
shot dm_11
wait 20
shot dm_12
wait 20
shot dm_13
wait 20
shot dm_14
wait 20
shot dm_15
wait 20
shot dm_16
wait 20
shot dm_17
wait 20
shot dm_18
wait 20
shot dm_19
wait 20
shot dm_20
wait 20
shot dm_21
wait 20
shot dm_22
wait 20
shot dm_23
