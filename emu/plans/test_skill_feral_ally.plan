# skills: Feral raises only its caster, whichever slot she is in. Jian (slot 0) and Gabryel (slot 1,
# party_jian_gabryel), Gabryel at level 21 (level index 20 pinned, battle MP pinned to 50), first temple
# battle. Jian Fights; Gabryel's list holds Gale Cut, Venom Claw, Blinding Swipe, and Feral (Down, Right;
# shot fa_list); A casts at once with no picker. Expect MP 50 -> 42, her ATK stage (record 1) 0 -> 1 and
# her ATK up, Jian's stage (record 0) still 0, and her first target slot (battler 1 + 0x8C, battlers at
# the address peeked below) = 1, her own battler.
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18, ATK +0x24, ATK stage +0x40). Run with --save.
include party_jian_gabryel
pin u32 0x020B471C 20
pinptr u32 0x020B8620 0x84 50
wait 270
peek u32 0x020B8620 records
peek u32 0x020B8640 battlers
watch u32 0x0228e8e4 gabryel_mp
watch u16 0x0228e8a0 jian_atk_stage
watch u32 0x0228e884 jian_atk
watch u16 0x0228e90c gabryel_atk_stage
watch u32 0x0228e8f0 gabryel_atk
watch u16 0x0228ef58 gabryel_target
press A 8
wait 50
press A 8
wait 60
press A 8
wait 60
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 50
press Right 8
wait 50
shot fa_list
press A 8
wait 30
peek u16 0x0228ef58 gabryel_target_at_cast
wait 0
wait 20
shot fa_00
wait 20
shot fa_01
wait 20
shot fa_02
wait 20
shot fa_03
wait 20
shot fa_04
wait 20
shot fa_05
wait 20
shot fa_06
wait 20
shot fa_07
wait 20
shot fa_08
wait 20
shot fa_09
wait 20
shot fa_10
wait 20
shot fa_11
wait 20
shot fa_12
wait 20
shot fa_13
wait 20
shot fa_14
wait 20
shot fa_15
wait 20
shot fa_16
wait 20
shot fa_17
wait 20
shot fa_18
wait 20
shot fa_19
wait 20
shot fa_20
wait 20
shot fa_21
wait 20
shot fa_22
wait 20
shot fa_23
