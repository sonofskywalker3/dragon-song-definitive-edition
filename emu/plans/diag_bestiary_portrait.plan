# Diagnostic: which top-screen layer holds Jian's portrait in the bestiary (opened with Y): sprites off, then each BG.
include boot_from_save
wait 100
poke u8 0x0213BA1B 1
poke u8 0x0213BA29 1
poke u8 0x0213BA38 1
poke u32 0x020B4664 22
watch u32 0x020AFF84 menu
watch u8 0x02139FD7 page_kind
press X 3
wait 80
press Down 8
wait 20
press Down 8
wait 30
press A 8
wait 60
press Down 8
wait 30
press Right 8
wait 30
press A 8
wait 60
press Y 6
wait 60
pin u8 0x04001001 0x0F
wait 4
shot p_no_obj
unpin
wait 4
pin u8 0x04001001 0x1E
wait 4
shot p_no_bg0
unpin
wait 4
pin u8 0x04001001 0x1D
wait 4
shot p_no_bg1
unpin
wait 4
pin u8 0x04001001 0x1B
wait 4
shot p_no_bg2
unpin
wait 4
pin u8 0x04001001 0x17
wait 4
shot p_no_bg3
unpin
wait 4
peek u16 0x04001008 bg0cnt
peek u16 0x0400100E bg3cnt
