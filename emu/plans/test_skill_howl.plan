# skills: Howl (fear: the game's paralysis, 70 percent). The random state is set to 24 (roll 3) at the
# effect hook site, so it lands. Gabryel alone at level 30 (level index 29 pinned, battle MP pinned to 50), first temple battle.
# On the Special list Right, Right reaches the skill (shot ho_list), A opens the enemy grid,
# Down moves to the first front-row enemy (battler 9, which stays in its slot; ho_grid), A casts:
# after the enemies' turns she runs in, strikes without damage, and the green ring shows on it (shots
# ho_a to ho_i), the MP is taken, and its status goes 0 -> 4. By the next round a back-row
# enemy has dropped into front slot 8, so Down, Right reaches battler 9: the name bar reads its name
# and "Par" (ho_tag) and A is refused with "No effect!" (ho_refused), no MP taken.
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18). Run with --save.
include party_gabryel
pin u32 0x020B471C 29
pinptr u32 0x020B8620 0x18 50
execpoke 0x020503A0 u32 0x020A0238 24
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
watch u32 0x0228ec40 hp9
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Right 8
wait 50
shot ho_list
press A 8
wait 80
press Down 8
wait 30
shot ho_grid
press A 8
wait 30
wait 210
wait 30
shot ho_a
wait 30
shot ho_b
wait 30
shot ho_c
wait 30
shot ho_d
wait 30
shot ho_e
wait 30
shot ho_f
wait 30
shot ho_g
wait 30
shot ho_h
wait 30
shot ho_i
waituntil u32 0x020B0010 7 3000
wait 110
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Right 8
wait 50
press A 8
wait 80
press Down 8
wait 30
press Right 8
wait 30
shot ho_tag
press A 8
wait 30
shot ho_refused
wait 100
shot ho_after
