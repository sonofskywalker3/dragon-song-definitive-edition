# cards: Gabryel at level 30 (Venom Claw known) wears Shreeker (card 218, her slot 0x020B475A) with 1200 points
# (0x020B4888). Venom Claw on battler 9: status 0 -> 6, points 1200 -> 1100, and on its turns the poison takes
# 10% of its max HP (watch hp9 against maxhp9) instead of 5%. Run with --save.
include party_gabryel
pin u32 0x020B471C 29
pinptr u32 0x020B8620 0x18 50
poke u8 0x0213BA09 1
poke u16 0x020B4888 1200
poke u16 0x020B475A 218
wait 270
watch u32 0x0228e878 gabryel_mp
watch u8 0x0228ec34 status9
watch u32 0x0228ec40 hp9
watch u32 0x0228ec48 maxhp9
watch u16 0x0228ec78 turns9
watch u16 0x020B4888 points
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
shot bv_name
press A 8
wait 80
press Down 8
wait 30
shot grid
press A 8
wait 30
shot picked
wait 210
waituntil u32 0x020B0010 7 3000
wait 110
shot bv_round2
wait 600
shot bv_round2b
press A 8
wait 50
press A 8
wait 60
press A 8
wait 1200
shot bv_round3
