# Viability study (docs/plan-curse.md): pin-warp to each map of the cursed stretch and dump its objects
# (32 x 0x40 at 0x020B6FD4: +0x12 id, +0x14 kind, +0x22 blue chest), the spawn point count (0x020B77F4),
# this map's group index (0x020B4906) and kill/total entry table (0x020B4908). Story flag 0x33 on.
include boot_from_save
wait 30
poke u32 0x02204624 0x80000
save room
load room
wait 5
pin u16 0x020B77EC 140
press Right 40
press Down,Right 40
press Right 40
press Down 80
wait 200
unpin
wait 60
peek u16 0x020B6BE4 map
peek u16 0x020B77F4 spawn_points
peek u16 0x020B4906 group_index
dump 0x020B4908 0xC0 group_entries
dump 0x020B6FD4 0x800 objects
shot map_140
load room
wait 5
pin u16 0x020B77EC 141
press Right 40
press Down,Right 40
press Right 40
press Down 80
wait 200
unpin
wait 60
peek u16 0x020B6BE4 map
peek u16 0x020B77F4 spawn_points
peek u16 0x020B4906 group_index
dump 0x020B4908 0xC0 group_entries
dump 0x020B6FD4 0x800 objects
