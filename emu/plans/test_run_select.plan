# Running from battle: the microphone must do nothing, Select must run (select-to-run).
# Temple battle (warp6). Logs the menu's "run chosen" field (0x020B8800 + 4 = 1) and the field
# state (0x020B0010) as the battle ends. Compare with a build without select-to-run.
include boot_from_save
include cheats_strong
include warp6
wait 270
watch u32 0x020B8804 run_chosen
watch u32 0x020B0010 field_state
shot run0
press Microphone 90
wait 60
shot run1_after_mic
press Select 3
wait 30
shot run2_after_select
wait 400
shot run3
