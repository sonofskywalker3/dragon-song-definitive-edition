# Viability study: the Cathedral of Althena maps (140 to 150) entered by real entrances (pin 0x020B77F2 entrance
# 101, then 102) so the maps draw and spawn properly; dumps as curse_route_maps.plan. Story flag 0x33 on.
include boot_from_save
wait 30
poke u32 0x02204624 0x80000
save room
load room
wait 5
pin u16 0x020B77EC 140
pin u16 0x020B77F2 101
press Right 40
press Down,Right 40
press Right 40
press Down 80
wait 200
unpin
wait 90
peek u16 0x020B6BE4 map
peek u16 0x020B77F4 spawn_points
peek u16 0x020B4906 group_index
dump 0x020B4908 0xC0 group_entries
dump 0x020B6FD4 0x800 objects
shot cath_140_e101
