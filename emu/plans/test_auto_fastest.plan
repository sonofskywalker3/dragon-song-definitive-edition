# Auto battle switches the speed to Fastest (feat_battle_speed.py): the speed level (0x020B8540) is 0 on Fast and
# 2 on Fastest. First temple battle: the opening page, then Right, A and A (OK) to pick Auto.
# Run with --save.
include boot_from_save
include cheats_strong
include warp6
watch u32 0x020B8540 speed_level
wait 270
shot af_top
press Right 3
wait 20
shot af_top_right
press A 3
wait 30
shot af_confirm
press A 3
wait 30
shot af_after
wait 300
shot af_later
