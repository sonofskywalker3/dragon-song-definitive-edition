# skills: Water Bind's failed roll. As test_skill_water_bind's first round with Flora's MP at 60 (field
# MP and max MP set before the battle) and the random state set to 15 (roll 98): the MP is taken (60 ->
# 51), no status changes, and the MISS popup shows over the enemy (shots wm_a to wm_t).
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18). Run with --save.
pin u32 0x020b4784 60
pin u32 0x020b4788 60
include party_flora
pin u32 0x020b4784 60
pin u32 0x020b4788 60
pin u32 0x020b4778 15
execpoke 0x020503A0 u32 0x020A0238 15
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e8e4 flora_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
press A 8
wait 50
press A 8
wait 60
press A 8
wait 60
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Down 8
wait 50
press A 8
wait 80
press Down 8
wait 30
press A 8
wait 30
waituntil u32 0x0228e8e4 51 3000
wait 8
shot wm_a
wait 8
shot wm_b
wait 8
shot wm_c
wait 8
shot wm_d
wait 8
shot wm_e
wait 8
shot wm_f
wait 8
shot wm_g
wait 8
shot wm_h
wait 8
shot wm_i
wait 8
shot wm_j
wait 8
shot wm_k
wait 8
shot wm_l
wait 8
shot wm_m
wait 8
shot wm_n
wait 8
shot wm_o
wait 8
shot wm_p
wait 8
shot wm_q
wait 8
shot wm_r
wait 8
shot wm_s
wait 8
shot wm_t
