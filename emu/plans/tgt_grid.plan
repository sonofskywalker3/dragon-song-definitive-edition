# Enemy picker grid: Jian (front row only) and Flora (both rows) in the temple battle with
# two front enemies (battlers 9, 10) and two flying back-row enemies (5, 6).
include boot_to_field
include cheats_strong
include warp6
poke u16 0x020B4650 3
poke u16 0x020B4780 999
poke u16 0x020B477C 999
wait 270
peek u32 0x0228F590 x5
peek u32 0x0228F6BC x6
peek u32 0x0228FA40 x9
peek u32 0x0228FB6C x10
exec 0x02051C48 attack_target
press A 3
wait 60
press A 3
wait 60
press A 3
wait 60
shot g1
dump 0x01FF85E0 12 tgt_state
dump 0x020B8840 0x14 menu_list
press Up 3
wait 20
shot g2
press Right 3
wait 20
shot g3
press A 3
wait 60
press A 3
wait 60
shot g4
dump 0x01FF85E0 12 tgt_state
dump 0x020B8840 0x14 menu_list
press Up 3
wait 20
shot g5
press Right 3
wait 20
shot g6
press Down 3
wait 20
shot g7
press Left 3
wait 20
shot g8
press Up 3
wait 20
shot g9
press A 3
wait 60
wait 1200
