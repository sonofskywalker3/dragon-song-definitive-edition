# Per-column drop mid-action (Jeff 2026-10-07): Jian's combo kills the left front enemy (slot 9, HP 1) while the
# right one (slot 10) lives; the flyer behind slot 9 drops in once it has faded, during the attack, and
# Jian's later swings stay in list order on slot 10. Shots every 8 frames. Run with --save.
include boot_from_save
include cheats_strong
include warp6
wait 270
poke u16 0x0228EA24 300
poke u16 0x0228EA90 300
poke u16 0x0228EAFC 300
poke u16 0x0228EC40 1
poke u16 0x0228ECAC 999
watch u16 0x0228EC40 hp9
watch u16 0x0228ECAC hp10
watch u16 0x0228EA24 hp4
watch u16 0x0228EA90 hp5
watch u16 0x0228EAFC hp6
watch u16 0x020B85E6 round_state
press A 3
wait 60
press A 3
wait 60
press A 3
wait 8
shot dc_01
wait 8
shot dc_02
wait 8
shot dc_03
wait 8
shot dc_04
wait 8
shot dc_05
wait 8
shot dc_06
wait 8
shot dc_07
wait 8
shot dc_08
wait 8
shot dc_09
wait 8
shot dc_10
wait 8
shot dc_11
wait 8
shot dc_12
wait 8
