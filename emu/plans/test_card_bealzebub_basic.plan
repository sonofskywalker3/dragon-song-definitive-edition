# cards: Bealzebub's basic version. Lucia (who does not know Focus) wears Bealzebub (card 227, her slot 0x020B46FE)
# at 1000 points (0x020B489A). Her card entry opens the ally picker ("Who to use it for?", shot bz_picker); A on the
# first ally (Jian) uses it on him alone: the battle flags (0x02282940) gain Jian's own sure-hit bit 0x100, not the
# party's 4; points 1000 -> 900. Run with --save.
include party2_strong
poke u8 0x0213ba12 1
poke u16 0x020b489a 1000
poke u16 0x020b46fe 227
pin u32 0x0228ea24 500
pin u32 0x0228ea90 500
pin u32 0x0228eafc 500
pin u32 0x0228ebd4 500
pin u32 0x0228ec40 500
pin u32 0x0228ecac 500
wait 270
watch u32 0x02282940 flags
watch u16 0x020b489a points
press A 8
wait 50
press A 8
wait 60
press A 8
wait 60
press Right 8
wait 50
press A 8
wait 60
press Down 8
wait 30
shot bz_card
press A 8
wait 60
shot bz_picker
press A 8
wait 60
wait 500
shot bz_after
