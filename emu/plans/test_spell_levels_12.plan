# Spell levels (feat_spell_levels.py): Lucia at level 12 (index 11 at 0x020B46C0) opens Special in the first
# temple battle; the list shows the spells learned by then. Run with --save.
include party2_strong
pin u32 0x020B46C0 11
include warp6
wait 270
press A 3
wait 30
press A 3
wait 30
press A 3
wait 30
press A 3
wait 30
press Right 3
wait 20
press A 3
wait 40
shot spells_lv12
press Down 3
wait 20
shot spells_lv12_down
