# cards: Steal on a monster with nothing to steal (docs/plan-cards.md 5). As test_card_steal's first round, with the
# Bealzebubs' two drop slots emptied (row 45: 0x020977AC and 0x020977AE = 0). Expect: A on the target is refused
# ("No effect!", the grid stays: shots sn_grid, sn_msg_*), no robbed bit, nothing stolen (0x01FFBB64 stays 0).
# Run with --save.
include party2_strong
poke u8 0x0213ba33 1
poke u16 0x020b46a2 260
poke u16 0x020977AC 0
poke u16 0x020977AE 0
pin u32 0x0228ea24 500
pin u32 0x0228ea90 500
pin u32 0x0228eafc 500
pin u32 0x0228ebd4 500
pin u32 0x0228ec40 500
pin u32 0x0228ecac 500
wait 270
battlers
watch u32 0x02282940 flags
watch u16 0x01FFBB64 stolen
watch u32 0x0228e878 jian_mp
press A 8
wait 50
press Right 8
wait 50
press A 8
wait 60
shot sn_list
press A 8
wait 60
shot sn_grid
press A 8
wait 60
press A 8
wait 60
press A 8
wait 60
waituntil u32 0x020B0010 8 3000
wait 20
shot sn_msg_0
wait 20
shot sn_msg_1
wait 20
shot sn_msg_2
wait 20
shot sn_msg_3
wait 20
shot sn_msg_4
wait 20
shot sn_msg_5
wait 20
shot sn_msg_6
wait 20
shot sn_msg_7
wait 20
shot sn_msg_8
wait 20
shot sn_msg_9
wait 20
shot sn_msg_10
wait 20
shot sn_msg_11
wait 20
shot sn_msg_12
wait 20
shot sn_msg_13
wait 20
shot sn_msg_14
wait 20
shot sn_msg_15
