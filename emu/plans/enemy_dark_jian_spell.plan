# Dark Jian copies Jian's Special: Manual battle, Jian casts Inferno each round (docs/re-enemy-attacks.md 6).
# Run with --save build/emu/saves/start.SaveRAM; create <out>/rec first. Generated by dsde.enemy_anims.make_plan;
# the Fast pin address (pin u8 0x01ff9c6c 1) moves with the feature layout.
# generated by dsde.enemy_anims: 151_Dark_Jian_a1_skill13 (dj)
# Power-on, Load Game, slot 1: Jian in his room after the intro (needs --save; about 2200 frames
# instead of 16000 for boot_to_field)
wait 1500
touch 128 108 5
wait 120
press A 3
wait 60
press A 3
wait 300
press A 3
wait 120
# Make Jian hard to kill and hit hard (test only)
pin u16 0x020B466C 999
pin u16 0x020B4668 999
pin u8 0x020B4678 255
pin u8 0x020B467C 255
pin u8 0x020B4684 255
pin u8 0x020B468C 255
# Delrich Temple (map 6), standing off the enemy spawn points (as boss_gronk.plan)
pin u16 0x020B77EC 6
press Right 40
press Down,Right 40
press Right 40
press Down 80
wait 200
unpin
# Make Jian hard to kill and hit hard (test only)
pin u16 0x020B466C 999
pin u16 0x020B4668 999
pin u8 0x020B4678 255
pin u8 0x020B467C 255
pin u8 0x020B4684 255
pin u8 0x020B468C 255
pinptr u32 0x020b8620 0x14 999
pin u8 0x01ff9c6c 1
poke u16 0x0209ae74 30000
poke u16 0x0209ae88 30000
poke u32 0x0209ae70 0x80000003
poke u16 0x0209ae9c 0xffff
poke u16 0x0209ae9e 0x64
poke u16 0x0209aea0 0x64
poke u16 0x0209aea2 0x64
poke u8 0x0213b9fa 1
poke u16 0x020b46a0 0xcb
pinptr u32 0x020b8620 0x18 99
poke u16 0x020b7838 1
poke u16 0x020b783a 25
poke u32 0x020b0010 0x73
rec dj 2 2 1 151
waituntil u32 0x020b0010 7 3000
wait 110
shot cmd
# Manual: Jian casts Inferno each round, Dark Jian copies the Special
press A 3
wait 40
press Right 3
wait 30
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
waituntil u32 0x020b0010 7 3000
wait 110
press A 3
wait 40
press Right 3
wait 30
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
waituntil u32 0x020b0010 7 3000
wait 110
press A 3
wait 40
press Right 3
wait 30
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
press A 3
wait 40
waitrec 9000
shot end
battlers
