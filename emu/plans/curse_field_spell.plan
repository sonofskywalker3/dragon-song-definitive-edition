# curse-no-healing, field menu: Lucia casts Healing Water on cursed Jian (heals him at CURSE_HEAL_PERCENT, spends
# 4 MP), then on herself (full amount). Jian 5 of 999 HP, Lucia 5 HP; story flag 0x33 poked on (word 1 at 0x02204620).
include boot_from_save
# Jian max HP 999 so the heal amount shows uncapped
pin u32 0x020B466C 999
poke u32 0x02204624 0x80000
poke u32 0x020B4668 5
poke u32 0x020B46C4 5
include mp_open_special
shot fs_list
press A 8
wait 60
shot fs_target_jian
press A 8
wait 150
shot fs_after_jian
peek u32 0x020B4668 jian_hp_after
peek u32 0x020B46CC lucia_mp_after_jian
press Right 8
wait 20
shot fs_target_lucia
press A 8
wait 150
shot fs_after_lucia
peek u32 0x020B46C4 lucia_hp_after
peek u32 0x020B46CC lucia_mp_after_lucia
