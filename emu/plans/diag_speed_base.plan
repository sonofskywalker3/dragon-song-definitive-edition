# Pacing diagnostic (docs/re-curse-battle-speed.md): one round of Jian's Attack on the first Delrich
# Temple battle, no fast-forward. Logs the battle context pointer, the round state (battle ctx +0x2E),
# battler 12's action step (+0xCC), every step start (func_020316e0) and every hit (func_02030b44),
# and the built-in fast-forward level at 0x020B8540.
include boot_from_save
include cheats_strong
include warp6
wait 270
peek u32 0x020B8550 battle_ctx
peek u32 0x020B8640 battlers_ptr
watch u32 0x020B8540 ff_level
watch u16 0x0228FC7C b12_step
exec 0x020316E0 step_start
exec 0x02030B48 hit
press A 3
wait 60
press A 3
wait 60
press A 3
wait 60
press A 3
wait 600
shot speed_base_end
