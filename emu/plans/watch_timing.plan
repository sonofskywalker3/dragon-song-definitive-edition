# Pocketwatch: frame timing of the post-battle map reload, kill count, and HUD rebuild after the clearing
# battle, won with Auto (r_live from watch_reentry.plan in the same out dir)
load r_live
peek u16 0x020B6BE4 map
include watch_shuttle
shot k00_open_after_shuttle
include cheats_strong
# one enemy left: kills = total - 1
peek u8 0x020B4913 total
poke u8 0x020B4912 5
peek u32 0x020B6CB4 jx
peek u32 0x020B6CB8 jy
# dump the field objects, then pull one enemy symbol (slot 2) onto Jian: contact starts a battle
dump 0x020B6FD4 0x280 objs
pin u32 0x020b7058 0x51A000
pin u32 0x020b705c 0x46894A
wait 10
unpin
include cheats_strong
watch u8 0x020B4912 kills
watch u32 0x020B0010 fstate
wait 120
shot k01_battle
exec 0x02020870 map_reload
exec 0x020209A8 hud_rebuild
wait 400
press Right 3
wait 20
press A 3
wait 60
shot b_auto
press A 3
wait 20
press A 3
wait 20
press A 3
wait 20
