# skills: Binding Rain is refused when it would do nothing. Jian and Flora (party_flora), Flora at level
# 28, MP 60 (set through the field record). Before her command every enemy's status is poked to poison (6): A on
# Binding Rain is refused with "No effect!" (shot bn_refused), the list stays, no MP is taken. Then
# battler 9's status is cleared and the cast goes through with the random state set to 24: only battler
# 9 gets a ribbon and status 4 (bn_a to bn_p), MP 60 -> 47.
# Battle records at 0x0228E860 (0x6C each: status in the low nibble of +0x08, HP +0x14, MP +0x18). Run with --save.
pin u32 0x020b4784 60
pin u32 0x020b4788 60
include party_flora
pin u32 0x020b4784 60
pin u32 0x020b4788 60
pin u32 0x020b4778 27
execpoke 0x020503A0 u32 0x020A0238 24
wait 270
peek u32 0x020B8620 records
watch u32 0x0228e8e4 flora_mp
watch u8 0x0228ea18 status4
watch u8 0x0228ea84 status5
watch u8 0x0228eaf0 status6
watch u8 0x0228ebc8 status8
watch u8 0x0228ec34 status9
watch u8 0x0228eca0 status10
press A 8
wait 50
press A 8
wait 60
press A 8
wait 60
poke u8 0x0228ea18 6
poke u8 0x0228ea84 6
poke u8 0x0228eaf0 6
poke u8 0x0228ebc8 6
poke u8 0x0228ec34 6
poke u8 0x0228eca0 6
press Right 8
wait 50
press A 8
wait 60
press Right 8
wait 50
press Down 8
wait 50
press A 8
wait 20
shot bn_refused
wait 80
poke u8 0x0228ec34 0
press A 8
wait 30
waituntil u32 0x0228e8e4 47 3000
wait 10
shot bn_a
wait 10
shot bn_b
wait 10
shot bn_c
wait 10
shot bn_d
wait 10
shot bn_e
wait 10
shot bn_f
wait 10
shot bn_g
wait 10
shot bn_h
wait 10
shot bn_i
wait 10
shot bn_j
wait 10
shot bn_k
wait 10
shot bn_l
wait 10
shot bn_m
wait 10
shot bn_n
wait 10
shot bn_o
wait 10
shot bn_p
