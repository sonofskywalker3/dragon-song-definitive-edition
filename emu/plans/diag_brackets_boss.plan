# Diagnostic: Blue Dragon fight (as tgt_bluedragon), a shot before every A press, to catch the enemy picker with corners on the boss.
include boot_from_save
include cheats_strong
pin u16 0x020B77EC 6
press Right 40
press Down,Right 40
press Right 40
press Down 80
wait 200
unpin
wait 30
shot boss_field
poke u16 0x020B7838 1
poke u16 0x020B783A 11
